{
  "name": "aiedhk",
  "version": "0.1.0",
  "private": true,
  "description": "AIEDHK — AI in Education Hub of Knowledge | Hong Kong as an AIED Hub",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed:research": "tsx scripts/seed-research-papers.ts",
    "translate:research": "tsx scripts/translate-reviewed-papers.ts",
    "hygiene:check": "node scripts/check-worktree-clean.mjs",
    "hygiene:overlap": "node scripts/check-worktree-overlap.mjs",
    "release:verify": "npm run hygiene:check && npm run hygiene:overlap && npm run newsletter:images:check && npm test && npm run test:newsletter:integration && npm run build && npm run typecheck && npm run hygiene:overlap && npm run hygiene:check",
    "newsletter:admin": "tsx scripts/newsletter-admin.ts",
    "test:newsletter:integration": "node scripts/test-newsletter-integration.mjs",
    "newsletter:images:prepare": "node --import tsx scripts/prepare-newsletter-images.ts",
    "newsletter:images:check": "node --import tsx scripts/prepare-newsletter-images.ts --check",
    "newsletter:preview": "node --import tsx scripts/preview-newsletter.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "postcss": "8.5.6",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.17",
    "tsx": "^4.22.4",
    "typescript": "5.8.3"
  }
}
